# live-sim configuration
SERVER_PORT=8000
PATCH_INTERVAL=2

# To be used by the containers
VAST2SGAI_URL="http://vast-2-sgai:3000"
MORPHEUS_URL="http://morpheus"

# --- Overlay ad URLs (morpheus) ---
# All optional. If unset/empty, morpheus falls back to its compiled defaults
# (the values below) so the demo runs with no config. morpheus builds each
# overlay uri as ${AD_GEN_BASE_URL}/image/html?${MORPHEUS_<SHAPE>_QUERY}.
#
# host:port of the ad-gen API as the PLAYER (browser) must reach it. Use
# localhost for same-machine; set a LAN IP like http://192.168.68.85:8888 when
# serving to other machines.
AD_GEN_BASE_URL=http://localhost:8888
# Full query string (template_id + targeting params) appended after /image/html?
MORPHEUS_BANNER_QUERY=template_id=17306275-3762-45f9-9a86-c262b8925963&city=montevideo&gender=male&hobbies=football%2Cmusic&restrictions=diabetic&price=UYU200&favourite_colors=red%2Cblue%2Cblack
MORPHEUS_SKYSCRAPER_QUERY=template_id=cda83e2d-0cd9-44f6-b1d5-d9c0c62cc203&city=montevideo&gender=male&hobbies=football%2Cmusic&restrictions=diabetic%2Cceliac&favourite_colors=red%2Cblue%2Cblack&favourite_food=chivito
MORPHEUS_LSHAPE_RIGHT_QUERY=template_id=7822830e-10ff-449f-a5e6-f92f7899f442&gender=male&country=uruguay&restrictions=celiac&hobbies=gaming%2Cfootball%2Ctravelling&colors=black%2Cpink
MORPHEUS_LSHAPE_LEFT_QUERY=template_id=1ac069f1-0437-4a9d-861b-e29ad552c842&gender=male&country=uruguay&hobbies=gaming%2Cfootball%2Ctravelling&colors=black%2Cpink&age=27&social_media=%40qualabs

# --- Background video (live-sim) ---
# Background video for live-sim. Optional: if unset/empty or the file is missing,
# live-sim falls back to a synthetic SMPTE-bars source with a timecode overlay.
# Drop a video file in live-sim/media/ (mounted at /media) and point this at it.
# When set, FFmpeg loops the file, uses the file's audio, and omits the timecode overlay.
# LIVE_SIM_VIDEO=/media/surf.mp4
