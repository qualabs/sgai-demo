# ── live-sim ──────────────────────────────────────────────────────────────────

PATCH_INTERVAL=2

# Background video (optional). Drop the file in live-sim/media/ (mounted at /media)
# and point this var at the in-container path. When unset, falls back to a
# synthetic SMPTE-bars source with a timecode overlay.
# LIVE_SIM_VIDEO=/media/surf.mp4

# Video renditions: comma-separated WxH:BITRATEk. Order defines stream IDs:
# first entry → stream0, second → stream1, etc.
# Set ANALYSIS_VIDEO_RENDITION in stream-lens to the stream index to process.
LIVE_SIM_RENDITIONS="1920x1080:4000k,1280x720:2000k,854x480:1000k"
# Multi-rendition example:
# LIVE_SIM_RENDITIONS=1920x1080:4000k,1280x720:2000k

# Internal routing (container-to-container)
# Route live-sim output through stream-lens for AI context analysis (default),
# or directly to morpheus to skip analysis (VAST-only mode):
OUTPUT_URL=http://stream-lens:8001
# OUTPUT_URL=http://morpheus
VAST2SGAI_URL=http://vast-2-sgai:3000
REAL_TIME_AD_GEN_URL=http://ad-gen-api:8000


# ── morpheus ──────────────────────────────────────────────────────────────────

# Host:port of the ad-gen API as the PLAYER (browser) must reach it.
# Use localhost for same-machine; set a LAN IP when serving to other devices.
AD_GEN_BASE_URL=http://localhost:8888
# Query string appended after /image/html? — just the template_id per shape.
# Personalization params (country, gender, ...) are NOT hardcoded here: they
# flow in client-side from the MPD URL query via DASH ExtUrlQueryInfo.
MORPHEUS_BANNER_QUERY=template_id=
MORPHEUS_SKYSCRAPER_QUERY=template_id=
MORPHEUS_LSHAPE_RIGHT_QUERY=template_id=
MORPHEUS_LSHAPE_LEFT_QUERY=template_id=


# ── stream-lens ──────────────────────────────────────────────────────────

# Ollama model storage.
# Leave unset to use a Docker-managed volume (models persist across restarts).
# Set to your local ~/.ollama to reuse already-pulled models without re-downloading:
# OLLAMA_MODELS_DIR=/home/$USER/.ollama

# Google AI API key — required for video analysis track.
# Also used for fusion when FUSION_MODEL has no ":" (Google model ID format).
GOOGLE_API_KEY=

# Video analysis model (Google API)
VIDEO_MODEL=gemma-4-26b-a4b-it

# Fusion model. Backend auto-detected from model ID:
#   Ollama  (ID contains ":"):  FUSION_MODEL=gemma4:e4b  or  smollm2:1.7b
#   Google API (no ":"):        FUSION_MODEL=gemma-4-26b-a4b-it
FUSION_MODEL=gemma4:e4b
FUSION_MODEL_TIMEOUT=300
OLLAMA_URL=http://ollama:11434/api/generate

# Buffer / trigger (segment counts, not seconds)
# BUFFER_SIZE: how many segments to feed into the analysis
# ANALYSIS_TRIGGER_SEGMENTS: how many segments from the selected rendition to
#   receive before triggering. Defaults to BUFFER_SIZE if unset.
BUFFER_SIZE=7
# ANALYSIS_TRIGGER_SEGMENTS=7

SEG_DURATION_S=2

# Which rendition to buffer for analysis (stream index matching LIVE_SIM_RENDITIONS order).
# stream-lens returns HTTP 503 on /context if this ID is never seen in incoming segments.
ANALYSIS_VIDEO_RENDITION=2

# Frame extraction
FRAME_SAMPLE_MODE=iframes   # iframes (recommended) | fps
FRAME_SAMPLE_FPS=1.0        # used only when FRAME_SAMPLE_MODE=fps
MAX_FRAMES=15
FRAME_MAX_WIDTH=640

# Audio / transcription
WHISPER_MODEL=medium        # tiny | medium | large-v3
WHISPER_DEVICE=cpu          # cpu | cuda

# Fusion output — prefix for all KV tags generated by the fusion model.
# Morpheus reads tags prefixed with this value as context query params.
FUSION_CONTEXT_PREFIX=ctx_

# Optional: override model instructions (leave unset to use built-in defaults)
# FUSION_INSTRUCTIONS=
# VIDEO_ANALYSIS_INSTRUCTIONS=

# Internal routing
MORPHEUS_BASE_URL=http://morpheus
